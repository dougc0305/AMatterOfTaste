<?xml version="1.0" encoding="utf-8"?>
<!--
  This file is the SOURCE web.config. `dotnet publish` copies it to the publish
  output and injects the <handlers> and <aspNetCore> entries automatically.
  The redirect rule MUST live here, not in the deployed copy: deploy.bat
  robocopies the publish output over the deploy root, so any hand-edit to
  C:\inetpub\wwwroot\AMatterOfTaste\web.config is lost on the next deploy.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- amatteroftaste.us (apex) is an alias for the canonical www host.
           Permanently redirect it so the site has one canonical URL.
           The .well-known exclusion keeps ACME/Let's Encrypt HTTP validation
           from ever being redirected (win-acme currently self-hosts its
           challenge listener, but this stays correct if that changes). -->
      <rewrite>
        <rules>
          <rule name="Redirect apex to www" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTP_HOST}" pattern="^amatteroftaste\.us$" ignoreCase="true" />
              <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
            </conditions>
            <action type="Redirect" url="https://www.amatteroftaste.us/{R:1}" redirectType="Permanent" />
          </rule>
        </rules>
      </rewrite>

    </system.webServer>
  </location>
</configuration>
